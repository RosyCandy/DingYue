{
  "appId": "com.dingyue.app",
  "productName": "DingYue",
  "directories": {
    "output": "desktop-dist",
    "buildResources": "resources"
  },
  "files": [
    "electron/**/*",
    "desktop-files/**/*",
    "!**/*.map"
  ],
  "icon": "resources/icon.png",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "artifactName": "DingYue-${version}-windows-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "identity": null,
    "artifactName": "DingYue-${version}-macos-${arch}.${ext}"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "artifactName": "DingYue-${version}-${arch}.${ext}",
    "icon": "resources/icon-512.png"
  }
}