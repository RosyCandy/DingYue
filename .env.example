# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Frontend API base URL.
# Local dev: keep /api so Vite proxy forwards to your local backend.
# Production web build behind Nginx: keep the same-origin API path.
# Native mobile build: use the public API, e.g. https://ngaasiu.studio/api
VITE_API_BASE_URL="/api"

# Google OAuth Web client ID. This is embedded into the web and native builds.
VITE_GOOGLE_CLIENT_ID="333204279819-nlcgoo10ilkqd4faan6nnbqmmo9ch5vi.apps.googleusercontent.com"

# Backend Google OAuth client ID. It must match VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID="333204279819-nlcgoo10ilkqd4faan6nnbqmmo9ch5vi.apps.googleusercontent.com"

# Android OAuth is configured in Google Cloud with the package name and SHA-1.
# The Capacitor plugin uses the Web client ID above, not this Android client ID.
# Android client ID: 333204279819-jdc9ch07j10su7colqrs63oeq5ulatjj.apps.googleusercontent.com
# iOS client ID is configured in ios/App/App/Info.plist.
# iOS client ID: 333204279819-4upbq40fe51a444jsbr91soku4hdemcq.apps.googleusercontent.com

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET="replace_with_a_long_random_secret"
PORT="3001"
# Set NODE_ENV=production in systemd, not in this Vite-loaded file.

# MySQL Database Configuration
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your_password"
DB_NAME="DingYue"

# ── 邮箱验证码（注册 / 忘记密码）───────────────────────────
# 未配置 SMTP 时进入开发模式：验证码打印到服务端日志，并且只在
# NODE_ENV != production 时随接口响应返回（前端会自动填入）。
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="noreply@example.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="DuoDuo <noreply@example.com>"

# ── Apple 登录 ────────────────────────────────────────────
# iOS 原生登录的 id_token audience 是 App Bundle ID；
# Web / Android 走 Apple Services ID（需在 Apple 开发者后台配置域名与回调）。
# 后端允许多个 audience，用英文逗号分隔。
APPLE_ALLOWED_AUDIENCES="com.duoduo.app,com.duoduo.app.signin"
VITE_APPLE_CLIENT_ID="com.duoduo.app.signin"

# ── 微信登录（微信开放平台“网站应用”，Web 扫码）─────────────
# https://open.weixin.qq.com 创建网站应用，授权回调域名填站点域名
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
VITE_WECHAT_APP_ID=""

# ── QQ 登录（QQ 互联，Web 扫码）───────────────────────────
# https://connect.qq.com 创建应用，回调地址填站点根路径
QQ_APP_ID=""
QQ_APP_SECRET=""
VITE_QQ_APP_ID=""

# ── 通行密钥（Passkey / WebAuthn）─────────────────────────
# rpID 必须与访问域名一致（本地开发用 localhost 即可，无需配置）。
# 生产环境示例：
# PASSKEY_RP_ID="ngaasiu.studio"
# PASSKEY_EXPECTED_ORIGINS="http://localhost:3000,https://ngaasiu.studio"
PASSKEY_RP_ID="localhost"
PASSKEY_RP_NAME="DuoDuo"
PASSKEY_EXPECTED_ORIGINS=""
